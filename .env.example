# ---------------------------------------------------------------------------
# Database (PostgreSQL). Any Postgres provider works (Supabase, Neon, RDS,
# local docker). Prisma needs a direct connection string.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/messaging_app?schema=public"

# ---------------------------------------------------------------------------
# Auth.js (NextAuth). AUTH_SECRET must be a long random string.
# Generate with: openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Public URL the browser uses to reach the Next.js app.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# URL the browser uses to reach the dedicated Socket.IO server.
NEXT_PUBLIC_SOCKET_URL="http://localhost:4001"
SOCKET_SERVER_PORT=4001

# Internal server-to-server URL: the Next.js API process uses this to notify
# the socket server after a media upload completes. NOT exposed to the browser.
# In production this should be an internal/private URL (e.g. http://socket:4001).
SOCKET_SERVER_URL="http://localhost:4001"

# Shared secret the socket server uses to verify Auth.js session JWTs.
# Must be identical to AUTH_SECRET.
SOCKET_AUTH_SECRET="replace-with-a-long-random-string"

# ---------------------------------------------------------------------------
# Upstash Redis (REST API - works from serverless AND the socket server).
# Used for: rate limiting, presence (multi-tab session counts).
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ---------------------------------------------------------------------------
# Cloudflare R2 (S3-compatible object storage) for chat image uploads.
# Never exposed to the browser - server generates presigned PUT URLs.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-access-key"
R2_BUCKET_NAME="messaging-app-media"
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"

# ---------------------------------------------------------------------------
# GIPHY API (server-side only - key is never sent to the browser).
# https://developers.giphy.com/
# ---------------------------------------------------------------------------
GIPHY_API_KEY="your-giphy-api-key"

# ---------------------------------------------------------------------------
# Sightengine (image moderation - nudity/offensive detection model).
# https://sightengine.com/docs/
# ---------------------------------------------------------------------------
SIGHTENGINE_API_USER="your-sightengine-user"
SIGHTENGINE_API_SECRET="your-sightengine-secret"
